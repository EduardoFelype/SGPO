# Copie este arquivo para .env e ajuste os valores.

# Porta onde o sistema abre no navegador (http://localhost:3000)
APP_PORT=3000

# Banco MySQL usado pelo Docker Compose
MYSQL_DATABASE=sgpo
MYSQL_USER=sgpo
MYSQL_PASSWORD=troque-esta-senha
MYSQL_ROOT_PASSWORD=troque-esta-senha-root

# Endereço do banco. Usado apenas quando o sistema roda SEM Docker.
# No Docker ele é montado automaticamente a partir das variáveis acima.
DATABASE_URL=mysql://sgpo:troque-esta-senha@localhost:3306/sgpo

# Chave da sessão de login. Use uma chave aleatória com 32 caracteres ou mais.
# Para gerar: openssl rand -hex 32
JWT_SECRET=troque-por-uma-chave-aleatoria-com-32-caracteres-ou-mais

# Opcional: token da API FIPE Parallelum (fonte reserva; a principal é a BrasilAPI, sem token)
# FIPE_API_TOKEN=

# Opcional: criar o administrador pelo terminal com "pnpm seed:admin"
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# ADMIN_NAME=Administrador
# ADMIN_EMAIL=
